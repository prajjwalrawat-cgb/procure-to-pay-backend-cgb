{
  "name": "procure-to-pay-backend",
  "version": "0.0.0",
  "private": true,
  "description": "ProcureFlow backend — NestJS API + Python OCR sidecar (deploys to Railway)",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "node scripts/with-env.mjs pnpm --filter @procureflow/db build",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @procureflow/db migrate:deploy",
    "db:migrate:dev": "node scripts/with-env.mjs pnpm --filter @procureflow/db migrate:dev",
    "db:seed": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed",
    "db:seed:slice1": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice1",
    "db:seed:slice2": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice2",
    "db:seed:slice3": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice3",
    "db:seed:slice4": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice4",
    "db:seed:slice5": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice5",
    "db:seed:slice6": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice6",
    "db:seed:slice7": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice7",
    "db:seed:slice8": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice8",
    "db:seed:slice9": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice9",
    "db:seed:slice10a": "node scripts/with-env.mjs pnpm --filter @procureflow/db seed:slice10a",
    "db:seed:all": "pnpm db:seed && pnpm db:seed:slice1 && pnpm db:seed:slice2 && pnpm db:seed:slice3 && pnpm db:seed:slice4 && pnpm db:seed:slice5 && pnpm db:seed:slice6 && pnpm db:seed:slice7 && pnpm db:seed:slice8 && pnpm db:seed:slice9 && pnpm db:seed:slice10a",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed:all",
    "audit:verify": "node scripts/with-env.mjs pnpm --filter @procureflow/db audit:verify",
    "keys:gen": "node scripts/generate-jwt-keys.mjs",
    "postinstall": "pnpm --filter @procureflow/db run generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "turbo": "^2.0.4",
    "typescript": "5.4.5"
  }
}
