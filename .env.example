# =============================================================================
# ProcureFlow BACKEND — environment template. Copy to `.env` for local dev.
# On Railway, set these as service Variables instead (never commit real secrets).
# =============================================================================

NODE_ENV=development

# Railway injects $PORT; the API binds it automatically. API_PORT is the local
# fallback used by `pnpm dev`.
API_PORT=3001

# --- Postgres (Supabase) ---
# App connection uses a NON-superuser role so RLS is enforced.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=10"
# Direct/owner connection for prisma migrate + security:apply (bypasses RLS).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Redis (Upstash) ---
REDIS_URL="rediss://default:PASSWORD@HOST:6379"
# Master switch for every BullMQ worker. Leave false in any environment that
# processes invoices: OCR runs on a worker, no OCR means no 3-way match, and an
# unmatched invoice cannot be routed for approval.
DISABLE_BACKGROUND_JOBS=false
# Parks only the five cron workers (SLA sweep, analytics refresh, GSTR-2B
# reconcile, vendor maintenance + screening refresh) and leaves OCR + bulk
# import running. Every worker polls Redis around the clock whether or not
# there is work, so on a command-metered plan (Upstash free tier) the idle
# schedulers are what burns the quota. Set true to run on a free Redis tier.
DISABLE_SCHEDULED_JOBS=false

# --- Supabase Storage (S3-compatible) ---
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET=procureflow-dev
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=true

# --- Outbound email (vendor invites, lifecycle email) ---
# Transport is picked at boot: RESEND_API_KEY > SMTP_USER+SMTP_PASS > log-mode.
#
# An HTTPS transport is REQUIRED for hosted deploys — Railway and most other PaaS
# providers block outbound SMTP, so :465 and :587 both time out there (Railway
# allows SMTP on the Pro plan only). Set exactly one of the two keys below.
#
# Resend — best deliverability, but the SMTP_FROM *domain* must be DNS-verified
# (SPF + DKIM) in Resend or sends are rejected with 403.
RESEND_API_KEY=
# Brevo — needs no DNS: verify the single SMTP_FROM *address* by clicking the
# link Brevo mails to it. Fastest path to working mail; weaker deliverability.
BREVO_API_KEY=
#
# Direct SMTP — fine locally. Blank USER/PASS => log-mode (logged, not sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Procure To Pay <no-reply@cgbindia.com>
# Public web origin hosting the vendor portal (used to build email links).
APP_BASE_URL=http://localhost:3000

# --- OCR sidecar (second Railway service) ---
# Empty => built-in sandbox OCR simulator. On Railway use the private URL:
#   OCR_API_URL=http://ocr.railway.internal:8000
OCR_API_URL=

# --- JWT (RS256) — base64-encoded PEM keys. Generate with `pnpm keys:gen`. ---
JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PRIVATE_KEY_PEM
JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PUBLIC_KEY_PEM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=procureflow.io
JWT_BUYER_AUDIENCE=buyer
JWT_VENDOR_AUDIENCE=vendor

# --- API ---
# Comma-separated allowed browser origins = the deployed frontend (Vercel) URLs.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
API_RATE_LIMIT_DEFAULT=300
API_RATE_LIMIT_PAYMENT=30
LOG_LEVEL=info
