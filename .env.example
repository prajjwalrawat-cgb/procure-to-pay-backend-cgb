# =============================================================================
# ProcureFlow BACKEND — environment template. Copy to `.env` for local dev.
# On Railway, set these as service Variables instead (never commit real secrets).
# =============================================================================

NODE_ENV=development

# Railway injects $PORT; the API binds it automatically. API_PORT is the local
# fallback used by `pnpm dev`.
API_PORT=3001

# --- Postgres (Supabase) ---
# App connection uses a NON-superuser role so RLS is enforced.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=10"
# Direct/owner connection for prisma migrate + security:apply (bypasses RLS).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Redis (Upstash) ---
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# --- Supabase Storage (S3-compatible) ---
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET=procureflow-dev
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=true

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=Procure To Pay <no-reply@cgbindia.com>

# --- OCR sidecar (second Railway service) ---
# Empty => built-in sandbox OCR simulator. On Railway use the private URL:
#   OCR_API_URL=http://ocr.railway.internal:8000
OCR_API_URL=

# --- JWT (RS256) — base64-encoded PEM keys. Generate with `pnpm keys:gen`. ---
JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PRIVATE_KEY_PEM
JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PUBLIC_KEY_PEM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=procureflow.io
JWT_BUYER_AUDIENCE=buyer
JWT_VENDOR_AUDIENCE=vendor

# --- API ---
# Comma-separated allowed browser origins = the deployed frontend (Vercel) URLs.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
API_RATE_LIMIT_DEFAULT=300
API_RATE_LIMIT_PAYMENT=30
LOG_LEVEL=info
