{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "REDIS_URL",
    "JWT_PRIVATE_KEY",
    "JWT_PUBLIC_KEY",
    "JWT_PRIVATE_KEY_BASE64",
    "JWT_PUBLIC_KEY_BASE64",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "JWT_ISSUER",
    "JWT_BUYER_AUDIENCE",
    "JWT_VENDOR_AUDIENCE",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "S3_FORCE_PATH_STYLE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "API_PORT",
    "API_CORS_ORIGINS",
    "API_RATE_LIMIT_DEFAULT",
    "API_RATE_LIMIT_PAYMENT",
    "LOG_LEVEL",
    "WEB_PORT",
    "VENDOR_PORT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_VENDOR_API_URL",
    "API_INTERNAL_URL",
    "VENDOR_ZONE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
