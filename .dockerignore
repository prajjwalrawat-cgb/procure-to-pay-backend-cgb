# Keep the build context small and reproducible.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/*.log

# Never bake secrets or local env into the image.
.env
.env.*
!.env.example

# VCS / editor / CI noise
.git
.github
.vscode
.idea

# (The Python OCR service used to live here under services/ocr-service. It is
# now its own repository, procure-to-pay-ocr, deployed as a separate service and
# reached over HTTP via OCR_API_URL — nothing of it is in this build context.)
