// ─────────────────────────────────────────────────────────────────────────────
// Slice 8 — Analytics & MSME compliance
// Aggregation layer is job-refreshed RLS-protected summary tables (not Postgres
// materialized views: MVs cannot carry RLS policies, which Master Context §3
// rule #1 forbids). See ADR-028. Each summary row carries refreshedAt; the
// AnalyticsRefreshLog tracks per-view refresh status for the "as of" UI badge.
// ─────────────────────────────────────────────────────────────────────────────

enum SavingsInitiativeType {
  HARD_RFQ          // negotiated via RFQ: baseline highest-qualified-quote vs awarded
  PRICE_IMPROVEMENT // PO unit price below reference (labelled "price improvement", not "savings")
  SOFT_PAYMENT_TERM // working-capital benefit from extended payment terms (estimate)
  AVOIDED_COST      // self-reported, requires justification + review
}

enum SavingsSourceType {
  RFQ_AWARD
  NEGOTIATED_PO
  PAYMENT_TERM
  MANUAL
}

enum SavingsEntryStatus {
  CONFIRMED
  PENDING_REVIEW // avoided-cost awaiting sign-off
  REJECTED
}

/// Per-tenant compliance/finance config: RBI reference rate (MSME §15 interest =
/// rate x 3 per Master Context §9) and cost-of-capital for soft-savings estimates.
model TenantComplianceConfig {
  id                   String    @id
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  rbiReferenceRatePct  Decimal   @default("6.5000") @map("rbi_reference_rate_pct") @db.Decimal(6, 4)
  rbiRateEffectiveFrom DateTime? @map("rbi_rate_effective_from") @db.Timestamptz(6)
  rbiRateSource        String?   @map("rbi_rate_source")
  costOfCapitalPct     Decimal   @default("12.0000") @map("cost_of_capital_pct") @db.Decimal(6, 4)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
}

/// Savings ledger — written by event listeners (RFQ award, PO issue) and manual
/// avoided-cost entries. A real table (not a materialized view): it has a write path.
model SavingsLedgerEntry {
  id             String                @id
  tenantId       String                @map("tenant_id") @db.Uuid
  periodMonth    String                @map("period_month") // 'YYYY-MM'
  initiativeType SavingsInitiativeType @map("initiative_type")
  sourceType     SavingsSourceType     @map("source_type")
  sourceId       String?               @map("source_id") // awardId / poId / null
  vendorId       String?               @map("vendor_id")
  category       String?
  baselineValue  Decimal               @map("baseline_value") @db.Decimal(18, 4)
  awardedValue   Decimal               @map("awarded_value") @db.Decimal(18, 4)
  savingsAmount  Decimal               @map("savings_amount") @db.Decimal(18, 4)
  savingsPct     Decimal               @map("savings_pct") @db.Decimal(9, 4)
  buyerId        String?               @map("buyer_id") // leaderboard attribution
  status         SavingsEntryStatus    @default(CONFIRMED)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?               @map("created_by")

  @@unique([tenantId, sourceType, sourceId, initiativeType])
  @@index([tenantId])
  @@index([tenantId, periodMonth])
  @@index([tenantId, buyerId])
}

/// Tracks the last refresh of each summary view per tenant — powers the "as of"
/// badge and the manual-refresh polling endpoint.
model AnalyticsRefreshLog {
  id          String   @id
  tenantId    String   @map("tenant_id") @db.Uuid
  viewName    String   @map("view_name")
  refreshedAt DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)
  durationMs  Int?     @map("duration_ms")
  status      String   @default("OK")
  trigger     String   @default("SCHEDULED") // SCHEDULED | EVENT | MANUAL

  @@unique([tenantId, viewName])
  @@index([tenantId])
}

/// Summary: net/gross/tax spend + txn count per month (from Invoice). Exact ledger match.
model AnalyticsSpendMonthly {
  id          String   @id
  tenantId    String   @map("tenant_id") @db.Uuid
  month       String // 'YYYY-MM'
  grossSpend  Decimal  @default("0") @map("gross_spend") @db.Decimal(18, 4)
  taxSpend    Decimal  @default("0") @map("tax_spend") @db.Decimal(18, 4)
  netSpend    Decimal  @default("0") @map("net_spend") @db.Decimal(18, 4)
  txnCount    Int      @default(0) @map("txn_count")
  refreshedAt DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)

  @@unique([tenantId, month])
  @@index([tenantId])
}

/// Summary: net/gross spend + txn count per vendor per month (concentration + top-vendors).
model AnalyticsVendorMonthly {
  id          String   @id
  tenantId    String   @map("tenant_id") @db.Uuid
  vendorId    String   @map("vendor_id")
  month       String
  grossSpend  Decimal  @default("0") @map("gross_spend") @db.Decimal(18, 4)
  netSpend    Decimal  @default("0") @map("net_spend") @db.Decimal(18, 4)
  txnCount    Int      @default(0) @map("txn_count")
  refreshedAt DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)

  @@unique([tenantId, vendorId, month])
  @@index([tenantId])
  @@index([tenantId, month])
}

/// Summary: AP performance per month (first-pass yield, exceptions, straight-through, cycle time).
model AnalyticsApMonthly {
  id                  String   @id
  tenantId            String   @map("tenant_id") @db.Uuid
  month               String
  invoicesTotal       Int      @default(0) @map("invoices_total")
  invoicesFirstPass   Int      @default(0) @map("invoices_first_pass")
  invoicesException   Int      @default(0) @map("invoices_exception")
  invoicesStraightThr Int      @default(0) @map("invoices_straight_through")
  cycleHoursSum       Decimal  @default("0") @map("cycle_hours_sum") @db.Decimal(18, 4)
  cycleCount          Int      @default(0) @map("cycle_count")
  refreshedAt         DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)

  @@unique([tenantId, month])
  @@index([tenantId])
}

/// Summary: MSME breach count + interest exposure per month (compliance trend).
model AnalyticsMsmeMonthly {
  id             String   @id
  tenantId       String   @map("tenant_id") @db.Uuid
  month          String
  breachCount    Int      @default(0) @map("breach_count")
  breachExposure Decimal  @default("0") @map("breach_exposure") @db.Decimal(18, 4)
  refreshedAt    DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)

  @@unique([tenantId, month])
  @@index([tenantId])
}

// ─────────────────────────── Contracts (Slice 9) ───────────────────────────

enum ContractType {
  RATE_CONTRACT
  FRAMEWORK_AGREEMENT
  BLANKET_PO
  SERVICE_AGREEMENT
}

enum ContractStatus {
  DRAFT
  UNDER_NEGOTIATION
  AWAITING_APPROVAL
  APPROVED // approved, awaiting execution (PDF generation)
  ACTIVE
  AWAITING_VENDOR_SIGNATURE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  SUPERSEDED
}

enum CommitmentPeriod {
  ANNUAL
  CONTRACT_LIFETIME
}

enum ContractClauseType {
  PAYMENT_TERMS
  DELIVERY_SLA
  QUALITY_STANDARD
  PENALTY
  FORCE_MAJEURE
  CONFIDENTIALITY
  IP
  TERMINATION
  LIABILITY
  INSURANCE
  CUSTOM
}

enum EscalationType {
  INDEXED
  FIXED_STEP
}

enum VolumeTrackingStatus {
  ON_TRACK
  AT_RISK
  SHORTFALL
}

enum ContractDocType {
  EXECUTED_PDF
  AMENDMENT
  VENDOR_COUNTERSIGNED
  SUPPORTING_ANNEXURE
}

enum ContractRenewalAlertType {
  NOTICE_90D
  NOTICE_60D
  NOTICE_30D
  EXPIRED
}

enum RenewalAlertAction {
  RENEWED
  ALLOWED_TO_EXPIRE
  TERMINATED_EARLY
  UNDER_NEGOTIATION
}

enum ContractAmendmentStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

/// A pre-negotiated agreement POs are issued against (call-offs) without
/// re-approval of pricing. Structured data (rate cards, clauses, commitments)
/// the PO engine validates against — not merely an attached document.
model Contract {
  id                           String           @id
  tenantId                     String           @map("tenant_id") @db.Uuid
  number                       String
  title                        String
  contractType                 ContractType     @map("contract_type")
  vendorId                     String           @map("vendor_id")
  category                     String
  rfqId                        String?          @map("rfq_id") // if born from a Slice 6 FRAMEWORK RFQ
  status                       ContractStatus   @default(DRAFT)
  validityStart                DateTime         @map("validity_start") @db.Timestamptz(6)
  validityEnd                  DateTime         @map("validity_end") @db.Timestamptz(6)
  autoRenew                    Boolean          @default(false) @map("auto_renew")
  renewalNoticeDays            Int              @default(90) @map("renewal_notice_days")
  currency                     String           @default("INR")
  totalValueEstimate           Decimal          @default("0") @map("total_value_estimate") @db.Decimal(18, 4)
  minimumCommitmentValue       Decimal?         @map("minimum_commitment_value") @db.Decimal(18, 4)
  minimumCommitmentQty         Decimal?         @map("minimum_commitment_qty") @db.Decimal(18, 4)
  commitmentUom                String?          @map("commitment_uom")
  commitmentPeriod             CommitmentPeriod @default(ANNUAL) @map("commitment_period")
  paymentTermsSnapshot         Json?            @map("payment_terms_snapshot")
  escalationClause             Json?            @map("escalation_clause") // {type, indexRef?, reviewFrequency, capPct?}
  terminationNoticeDays        Int              @default(30) @map("termination_notice_days")
  governingLaw                 String?          @map("governing_law")
  disputeResolution            String?          @map("dispute_resolution")
  requireVendorCountersign     Boolean          @default(false) @map("require_vendor_countersign")
  skipPoApprovalWithinContract Boolean          @default(true) @map("skip_po_approval_within_contract")
  maxCallOffValue              Decimal?         @map("max_call_off_value") @db.Decimal(18, 4) // per-call-off cap (optional)
  parentContractId             String?          @map("parent_contract_id") // amendment/renewal predecessor
  supersedesContractId         String?          @map("supersedes_contract_id")
  approvalMatrixSnapshot       Json?            @map("approval_matrix_snapshot")
  amendmentNo                  Int              @default(0) @map("amendment_no")
  pdfS3Key                     String?          @map("pdf_s3_key")
  pdfGeneratedHash             String?          @map("pdf_generated_hash")
  executedAt                   DateTime?        @map("executed_at") @db.Timestamptz(6)
  executedBy                   String?          @map("executed_by")
  vendorSignedAt               DateTime?        @map("vendor_signed_at") @db.Timestamptz(6)
  terminatedAt                 DateTime?        @map("terminated_at") @db.Timestamptz(6)
  terminationReason            String?          @map("termination_reason")
  createdBy                    String?          @map("created_by")
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  vendor         Vendor                   @relation(fields: [vendorId], references: [id])
  rateCards      ContractRateCard[]
  clauses        ContractClause[]
  documents      ContractDocument[]
  callOffs       ContractCallOff[]
  volumeTracking ContractVolumeTracking[]
  amendments     ContractAmendment[]
  renewalAlerts  ContractRenewalAlert[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, validityEnd])
  @@index([vendorId])
}

/// Locked rate rows. Multi-year (rateYear), volume-banded, and route-based
/// (logistics) pricing all first-class. Call-off unit price is pulled from here.
model ContractRateCard {
  id            String   @id
  tenantId      String   @map("tenant_id") @db.Uuid
  contractId    String   @map("contract_id")
  lineNo        Int      @map("line_no")
  itemId        String?  @map("item_id")
  itemDesc      String   @map("item_desc")
  uom           String
  rateYear      Int      @default(1) @map("rate_year")
  unitRate      Decimal  @map("unit_rate") @db.Decimal(18, 4)
  taxRate       Decimal  @default("0") @map("tax_rate") @db.Decimal(6, 4)
  volumeBandMin Decimal? @map("volume_band_min") @db.Decimal(18, 4)
  volumeBandMax Decimal? @map("volume_band_max") @db.Decimal(18, 4)
  routeOrigin   String?  @map("route_origin")
  routeDest     String?  @map("route_destination")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime @map("effective_to") @db.Timestamptz(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

/// Clauses — library-sourced or custom. Executed contracts are frozen: library
/// edits never retroactively propagate (deliberate non-goal, Slice 9).
model ContractClause {
  id              String             @id
  tenantId        String             @map("tenant_id") @db.Uuid
  contractId      String             @map("contract_id")
  clauseType      ContractClauseType @map("clause_type")
  title           String
  contentText     String             @map("content_text")
  isFromLibrary   Boolean            @default(false) @map("is_from_library")
  libraryClauseId String?            @map("library_clause_id")
  orderNo         Int                @map("order_no")
  isMandatory     Boolean            @default(false) @map("is_mandatory")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

/// Tenant's reusable standard clauses. Only TENANT_ADMIN / LEGAL_OFFICER edit.
model ClauseLibrary {
  id          String             @id
  tenantId    String             @map("tenant_id") @db.Uuid
  clauseType  ContractClauseType @map("clause_type")
  title       String
  contentText String             @map("content_text")
  isDefault   Boolean            @default(false) @map("is_default")
  version     Int                @default(1)
  createdBy   String?            @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, clauseType])
}

model ContractDocument {
  id         String          @id
  tenantId   String          @map("tenant_id") @db.Uuid
  contractId String          @map("contract_id")
  docType    ContractDocType @map("doc_type")
  s3Key      String          @map("s3_key")
  filename   String
  fileHash   String?         @map("file_hash")
  mimeType   String?         @map("mime_type")
  sizeBytes  Int?            @map("size_bytes")
  uploadedAt DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy String?         @map("uploaded_by")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

/// Links a call-off PO back to the contract + the rate card row it used.
model ContractCallOff {
  id             String   @id
  tenantId       String   @map("tenant_id") @db.Uuid
  contractId     String   @map("contract_id")
  poId           String   @map("po_id")
  rateCardIdUsed String?  @map("rate_card_id_used")
  qty            Decimal  @db.Decimal(18, 4)
  value          Decimal  @db.Decimal(18, 4)
  calledOffAt    DateTime @default(now()) @map("called_off_at") @db.Timestamptz(6)
  calledOffBy    String?  @map("called_off_by")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
  @@index([poId])
}

/// Actual-vs-committed volume per commitment period. Surfaces take-or-pay risk;
/// does NOT post a shortfall liability (finance/Tally decision, out of scope).
model ContractVolumeTracking {
  id             String               @id
  tenantId       String               @map("tenant_id") @db.Uuid
  contractId     String               @map("contract_id")
  period         String // e.g. 'FY2026' or 'LIFETIME'
  committedQty   Decimal?             @map("committed_qty") @db.Decimal(18, 4)
  actualQty      Decimal              @default("0") @map("actual_qty") @db.Decimal(18, 4)
  committedValue Decimal?             @map("committed_value") @db.Decimal(18, 4)
  actualValue    Decimal              @default("0") @map("actual_value") @db.Decimal(18, 4)
  shortfallQty   Decimal?             @map("shortfall_qty") @db.Decimal(18, 4)
  shortfallValue Decimal?             @map("shortfall_value") @db.Decimal(18, 4)
  status         VolumeTrackingStatus @default(ON_TRACK)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, period])
  @@index([tenantId])
  @@index([contractId])
}

/// A mid-validity term change. Routes through its own CONTRACT_AMENDMENT approval,
/// scaled to the value of the change (not the whole contract).
model ContractAmendment {
  id                     String                  @id
  tenantId               String                  @map("tenant_id") @db.Uuid
  contractId             String                  @map("contract_id")
  amendmentNo            Int                     @map("amendment_no")
  status                 ContractAmendmentStatus @default(DRAFT)
  changeSummary          String                  @map("change_summary")
  changedFields          Json                    @map("changed_fields")
  changeValue            Decimal                 @default("0") @map("change_value") @db.Decimal(18, 4)
  approvalMatrixSnapshot Json?                   @map("approval_matrix_snapshot")
  requestedBy            String?                 @map("requested_by")
  requestedAt            DateTime                @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt             DateTime?               @map("approved_at") @db.Timestamptz(6)
  approvedBy             String?                 @map("approved_by")
  effectiveFrom          DateTime                @map("effective_from") @db.Timestamptz(6)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

/// Proactive renewal risk. Nightly job creates 90/60/30-day + EXPIRED rows.
model ContractRenewalAlert {
  id             String                   @id
  tenantId       String                   @map("tenant_id") @db.Uuid
  contractId     String                   @map("contract_id")
  alertType      ContractRenewalAlertType @map("alert_type")
  triggeredAt    DateTime                 @default(now()) @map("triggered_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?                @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?                  @map("acknowledged_by")
  actionTaken    RenewalAlertAction?      @map("action_taken")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, alertType])
  @@index([tenantId])
  @@index([contractId])
}

// ─────────────────────────── Integrations (Slice 10a) ───────────────────────────

/// External integration providers (Master Context §9). Kept as an enum so the
/// credential vault + usage log stay provider-agnostic in code.
enum IntegrationProvider {
  OCR
  GSP // GST Suvidha Provider — GSTR-2B, IRN, e-Way (ADR-033)
  EMAIL_INBOUND
  PENNY_DROP // (10b)
  BANK // (10b)
  GSTN // (10c)
  PAN // (10c)
  UDYAM // (10c)
  MCA // (10c)
  SANCTIONS // (10c)
  ADVERSE_MEDIA // (10c)
  CREDIT_BUREAU // (10c)
  ISO_CERT // (10c)
  CAPTCHA // (10c)
}

/// Per-tenant integration credentials, encrypted at rest (AES-256-GCM). The
/// ciphertext is NEVER returned in any API response, logged, or surfaced in an
/// error (ADR-033). Some tenants bring their own GSP account; others use ours.
model TenantIntegrationCredential {
  id            String              @id
  tenantId      String              @map("tenant_id") @db.Uuid
  provider      IntegrationProvider
  label         String? // e.g. 'Star Cement GSP account'
  ciphertext    String              @map("ciphertext") // base64(iv:tag:data)
  keyVersion    Int                 @default(1) @map("key_version")
  isActive      Boolean             @default(true) @map("is_active")
  lastRotatedAt DateTime?           @map("last_rotated_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

/// Per-call usage/cost ledger for priced integrations (OCR, GSP, screening).
/// Feeds future billing + per-tenant cost analysis from day one.
model IntegrationUsageLog {
  id           String              @id
  tenantId     String              @map("tenant_id") @db.Uuid
  provider     IntegrationProvider
  operation    String // e.g. 'ocr.extract', 'gstr2b.fetch', 'irn.validate'
  documentType String?             @map("document_type")
  documentId   String?             @map("document_id")
  costMicros   Int                 @default(0) @map("cost_micros") // INR × 1e6, integer-safe
  outcome      String              @default("OK") // OK | ERROR | CIRCUIT_OPEN | FALLBACK
  simulated    Boolean             @default(true) // true until a real provider is wired
  latencyMs    Int?                @map("latency_ms")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, provider, createdAt])
}

enum InboundEmailStatus {
  RECEIVED
  INVOICE_CREATED
  PENDING_VENDOR_MATCH // sender not recognised — AP must attribute
  DEAD_LETTER // malformed / no attachment / corrupt — AP handles manually
}

/// An inbound email captured by the intake worker/webhook. Preserves the raw
/// message for audit + manual handling; unrecognised senders and malformed
/// messages are quarantined here rather than silently creating invoices.
model InboundEmail {
  id            String             @id
  tenantId      String             @map("tenant_id") @db.Uuid
  fromEmail     String             @map("from_email")
  fromDomain    String             @map("from_domain")
  subject       String?
  status        InboundEmailStatus @default(RECEIVED)
  matchedVendorId String?          @map("matched_vendor_id")
  invoiceId     String?            @map("invoice_id")
  bodyS3Key     String?            @map("body_s3_key")
  attachmentS3Key String?          @map("attachment_s3_key")
  attachmentName String?           @map("attachment_name")
  deadLetterReason String?         @map("dead_letter_reason")
  providerMessageId String?        @map("provider_message_id")
  resolvedBy    String?            @map("resolved_by")
  resolvedAt    DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, status])
}

// ─────────────────────────── Banking (Slice 10b) ───────────────────────────

enum PaymentSubmissionStatus {
  INTENT // written BEFORE the bank call (crash-recovery anchor)
  SUBMITTED // bank accepted the batch for processing
  CONFIRMED // bank confirmed final settlement
  FAILED // submission failed as a whole (batch-level)
}

/// Idempotent bank-submission record (Slice 10b, ADR-034). Written BEFORE the
/// bank call so a crash mid-submission is recoverable/auditable rather than a
/// silent double-pay risk. One row per (paymentRunId, attemptNo); the
/// idempotencyKey is the bank Idempotency-Key for that attempt.
model PaymentSubmissionIntent {
  id             String                  @id
  tenantId       String                  @map("tenant_id") @db.Uuid
  paymentRunId   String                  @map("payment_run_id")
  attemptNo      Int                     @map("attempt_no")
  idempotencyKey String                  @unique @map("idempotency_key")
  status         PaymentSubmissionStatus @default(INTENT)
  bankBatchRef   String?                 @map("bank_batch_ref")
  fileHash       String?                 @map("file_hash")
  itemCount      Int                     @default(0) @map("item_count")
  acceptedCount  Int                     @default(0) @map("accepted_count")
  failedCount    Int                     @default(0) @map("failed_count")
  simulated      Boolean                 @default(true)
  errorMessage   String?                 @map("error_message")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt    DateTime?               @map("submitted_at") @db.Timestamptz(6)
  confirmedAt    DateTime?               @map("confirmed_at") @db.Timestamptz(6)

  @@unique([paymentRunId, attemptNo])
  @@index([tenantId])
  @@index([paymentRunId])
}

// ══════════════════════ Inventory Management (Slice 12) ══════════════════════
//
// A native warehouse inventory module (ADR-036), reverse-engineered from a real
// operating gifting-warehouse workbook — NOT a generic e-commerce schema.
//
// Design principle: ONE insert-only, immutable ledger (`StockLedgerEntry`).
// Every physical movement writes exactly one row; nothing is updated or deleted.
// Corrections are compensating entries linked via `correctionOfId`. Current
// stock is SUM(qty * direction) grouped by (product_id, location_id).
//
// Relationship to Slice 5's `StockLedger`: they are deliberately parallel and
// independent. `StockLedger` is the *financial* ledger — Decimal quantities,
// snapshot running balances, weighted-average/FIFO valuation, item+plant scoped,
// written by GRN posting. `StockLedgerEntry` is the *physical* warehouse ledger —
// integer piece counts, product+location scoped, spanning vendor receipts,
// internal issues, D2C order fulfilment and returns. Neither can express the
// other, so nothing auto-posts between them; inventory receipts merely validate
// `purchaseOrderId` against the PO module and may carry an informational
// `grnId`/`rmaId` back-reference.

/// Every physical movement shape observed across the nine source sheets.
enum StockTxnType {
  VENDOR_INWARD // Vendor Inward Sheet — GRN receipt against a PO
  VENDOR_RETURN_OUT // Vendor Outward Sheet — gate-pass return (e.g. for repair)
  SAMPLE_INWARD // Sample Inward Sheet — non-stock sample receipt
  INTERNAL_ISSUE // Photoshoot / Sales / Other issue to a person or place
  INTERNAL_RETURN // partial or full return against an INTERNAL_ISSUE
  CUSTOMER_ORDER_OUT // Daily Order Report — Amazon/Shopify dispatch
  CUSTOMER_RETURN_IN // Return Inventory — customer return intake
  DAMAGE_WRITE_OFF // damage removed from sellable stock
  ADJUSTMENT // opening stock, migration seeding, stock counts, corrections
}

/// Which internal team an INTERNAL_ISSUE went to (source sheets are per-team).
enum IssueDept {
  PHOTOSHOOT
  SALES
  OTHER
}

/// Inventory-side QC verdict. Deliberately simpler than Slice 5's `GrnQcStatus`
/// (which drives AQL sampling plans) — the source sheet only records Ok/Rejected.
enum QcStatus {
  PENDING
  OK
  REJECTED
}

/// Warehouse product catalogue. Distinct from the `Item` procurement master:
/// `Item` mandates hsnCode/gstRate/primaryUom, which none of the 625 legacy rows
/// carry. `itemId` optionally bridges a warehouse SKU to its procurement Item.
model Product {
  id                   String    @id
  tenantId             String    @map("tenant_id") @db.Uuid
  /// Auto-generated {CATEGORY_PREFIX}-{sequence}, e.g. HD-000123. Supersedes the
  /// legacy Product ID / SKU columns, which are "N/A" on all 625 source rows.
  code                 String
  legacyProductId      String?   @map("legacy_product_id")
  legacySku            String?   @map("legacy_sku")
  name                 String
  /// Required going forward; legacy nulls are backfilled as "Uncategorized"
  /// (601 of 625 source rows have no category).
  category             String
  colour               String?
  imageUrl             String?   @map("image_url")
  unit                 String    @default("pcs")
  reorderPoint         Int?      @map("reorder_point")
  expiryOrWarrantyDate DateTime? @map("expiry_or_warranty_date") @db.Timestamptz(6)
  /// Product-level free-text notes, carried over verbatim at migration. Distinct
  /// from StockLedgerEntry.remark, which is per-transaction.
  remark               String?
  active               Boolean   @default(true)
  /// Optional bridge to the Slice 4 procurement item master.
  itemId               String?   @map("item_id")
  /// Traceability back to the bulk upload that created this product, if any.
  createdFromImportBatchId String? @map("created_from_import_batch_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Powers "Last Updated" — the ledger service touches this on every entry.
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  item          Item?              @relation(fields: [itemId], references: [id])
  ledgerEntries StockLedgerEntry[]

  @@unique([tenantId, code])
  /// Migration matching key from the legacy sheet — verified unique across all
  /// 625 source rows. A partial index in the migration SQL closes the NULL-colour
  /// hole that Postgres would otherwise leave open.
  @@unique([tenantId, name, colour])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, active])
}

/// Physical storage location. Stock lives in several locations per SKU
/// simultaneously, recorded today as free text ("Confrance Room-600 & -B2-205").
/// `parentId` allows optional room -> rack -> bin nesting.
model Location {
  id       String  @id
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  rackNo   String? @map("rack_no")
  parentId String? @map("parent_id")
  active   Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  parent        Location?          @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]         @relation("LocationTree")
  ledgerEntries StockLedgerEntry[]

  @@unique([tenantId, name, rackNo])
  @@index([tenantId])
  @@index([parentId])
}

/// THE immutable ledger. Insert-only: no update or delete route is exposed
/// anywhere. Mistakes are corrected with an offsetting ADJUSTMENT entry that
/// points back via `correctionOfId`.
model StockLedgerEntry {
  id         String       @id
  tenantId   String       @map("tenant_id") @db.Uuid
  productId  String       @map("product_id")
  locationId String       @map("location_id")
  txnType    StockTxnType @map("txn_type")
  /// Always positive; the sign lives in `direction`.
  qty        Int
  /// +1 or -1, denormalised so current stock is a plain SUM(qty * direction).
  direction  Int

  // ── vendor-side refs (VENDOR_INWARD / VENDOR_RETURN_OUT / SAMPLE_INWARD) ──
  vendorId        String?   @map("vendor_id")
  purchaseOrderId String?   @map("purchase_order_id")
  invoiceId       String?   @map("invoice_id")
  /// Informational back-reference to a formal Slice 5 GoodsReceiptNote / RMA.
  grnId           String?   @map("grn_id")
  rmaId           String?   @map("rma_id")
  grnNo           String?   @map("grn_no")
  gatePassNo      String?   @map("gate_pass_no")
  rate            Decimal?  @db.Decimal(18, 4)
  taxPct          Decimal?  @map("tax_pct") @db.Decimal(6, 4)
  qcStatus        QcStatus? @map("qc_status")
  damageQty       Int?      @default(0) @map("damage_qty")

  // ── internal issue refs ──────────────────────────────────────────────────
  issueDept           IssueDept? @map("issue_dept")
  /// Team member / sales person / place the stock went to.
  issuedToName        String?    @map("issued_to_name")
  approvedById        String?    @map("approved_by_id")
  /// Running unreturned balance for this issue. Status is derived: > 0 = Open.
  balanceQty          Int?       @map("balance_qty")
  tentativeReturnDate DateTime?  @map("tentative_return_date") @db.Timestamptz(6)
  /// Set on INTERNAL_RETURN rows — the INTERNAL_ISSUE they discharge.
  issueEntryId        String?    @map("issue_entry_id")

  // ── customer order refs ──────────────────────────────────────────────────
  platform     String? // Amazon / Shopify / etc
  orderId      String?  @map("order_id")
  customerName String?  @map("customer_name")
  courierName  String?  @map("courier_name")
  trackingId   String?  @map("tracking_id")
  paymentMode  String?  @map("payment_mode")
  orderValue   Decimal? @map("order_value") @db.Decimal(18, 4)

  // ── customer return refs ─────────────────────────────────────────────────
  returnReason     String?  @map("return_reason")
  productCondition String?  @map("product_condition")
  /// Null until decided; false routes the qty to DAMAGE_WRITE_OFF.
  restockDecision  Boolean? @map("restock_decision")

  /// Immutability escape hatch (business rule 6) — the entry this one offsets.
  correctionOfId String?  @map("correction_of_id")
  performedById  String   @map("performed_by_id")
  remark         String?
  txnDate        DateTime @default(now()) @map("txn_date") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Set when this row was created via bulk upload.
  importBatchId String? @map("import_batch_id")
  /// "<sheet>:<row>" — traceability back to the original file row.
  sourceRowRef  String? @map("source_row_ref")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  vendor        Vendor?            @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  invoice       Invoice?           @relation(fields: [invoiceId], references: [id])
  correctionOf  StockLedgerEntry?  @relation("LedgerCorrection", fields: [correctionOfId], references: [id])
  corrections   StockLedgerEntry[] @relation("LedgerCorrection")
  issueEntry    StockLedgerEntry?  @relation("IssueReturn", fields: [issueEntryId], references: [id])
  returns       StockLedgerEntry[] @relation("IssueReturn")
  importBatch   ImportBatch?       @relation(fields: [importBatchId], references: [id])

  @@unique([importBatchId, sourceRowRef])
  @@index([tenantId])
  @@index([productId, locationId])
  @@index([txnType, txnDate])
  @@index([tenantId, txnType, txnDate])
  @@index([tenantId, orderId])
  @@index([issueEntryId])
  @@index([purchaseOrderId])
}

// ─────────────────── Bulk Upload (Slice 12, first-class) ───────────────────
// The legacy Excel migration is the first use, but bulk upload is a permanent
// capability: staged, validated and resumable rather than a one-off script.

enum ImportType {
  PRODUCT_MASTER
  STOCK_LEDGER
}

enum ImportRowStatus {
  PENDING
  VALID
  CREATED
  UPDATED
  ERROR
  SKIPPED // e.g. quarantined pending manual product match
}

model ImportBatch {
  id           String     @id
  tenantId     String     @map("tenant_id") @db.Uuid
  importType   ImportType @map("import_type")
  fileName     String     @map("file_name")
  uploadedById String     @map("uploaded_by_id")
  /// PROCESSING | COMPLETED | COMPLETED_WITH_ERRORS | FAILED
  status       String     @default("PROCESSING")
  totalRows    Int        @default(0) @map("total_rows")
  successRows  Int        @default(0) @map("success_rows")
  errorRows    Int        @default(0) @map("error_rows")
  skippedRows  Int        @default(0) @map("skipped_rows")
  errorMessage String?    @map("error_message")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  rows          ImportRow[]
  ledgerEntries StockLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model ImportRow {
  id            String          @id
  tenantId      String          @map("tenant_id") @db.Uuid
  batchId       String          @map("batch_id")
  rowNumber     Int             @map("row_number")
  /// Original row, untouched — enables re-processing without re-uploading.
  rawData       Json            @map("raw_data")
  status        ImportRowStatus @default(PENDING)
  productId     String?         @map("product_id")
  ledgerEntryId String?         @map("ledger_entry_id")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  batch  ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId, status])
  @@index([tenantId])
}
