// ProcureFlow — Prisma schema. Covers ALL core entities from Master Context §7.
// Conventions:
//   • Money is Decimal(18,4)               (§3 rule #4)
//   • Timestamps are timestamptz UTC       (§3 rule #5)
//   • tenant_id on every tenanted model    (§4) — RLS applied in security SQL
//   • Table names PascalCase; RLS policies reference the `tenant_id` column.
// IDs are ULIDs with an entity prefix (e.g. inv_01H...), generated in app code.
// Tenant.id is a real uuid so `tenant_id = current_setting(...)::uuid` works.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  // "native" covers local dev; "debian-openssl-3.0.x" is the query-engine target
  // for the node:20-slim (Debian bookworm / OpenSSL 3) Docker runtime on Railway.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum RequisitionStatus {
  DRAFT
  SUBMITTED // legacy (Slice 0/1) — retained for existing rows
  PENDING_APPROVAL // legacy
  CONVERTED // legacy
  BUDGET_BREACH_HELD // Slice 4 — submit blocked on budget; user may revise
  AWAITING_APPROVAL // Slice 4
  APPROVED
  PARTIALLY_ISSUED // Slice 4 — some PR lines converted to PO(s)
  FULLY_ISSUED // Slice 4 — all PR lines converted
  REJECTED
  WITHDRAWN // Slice 4 — submitter pulled back before first decision
  CANCELLED
  CLOSED // Slice 4
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL // legacy (Slice 0/1)
  AWAITING_APPROVAL // Slice 4 — routed through the approval engine
  APPROVED
  ISSUED
  ACKNOWLEDGED // Slice 4 — vendor confirmed receipt
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_INVOICED // Slice 4
  INVOICED // Slice 4
  CLOSED
  CANCELLED
  ON_HOLD // Slice 4
}

