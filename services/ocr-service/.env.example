# OCR service configuration. Copy to .env for local runs (or set in compose).

# Engine: azure_doc_intelligence (default) | rapidocr | paddleocr
OCR_PROVIDER=azure_doc_intelligence

# --- Azure Document Intelligence (OCR_PROVIDER=azure_doc_intelligence) ---
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# --- LLM for structured extraction ---
# Required for OCR_PROVIDER=rapidocr / paddleocr, and used as the Azure bad-scan
# fallback. Any litellm-supported model works.
LLM_MODEL=gpt-4o
LLM_API_KEY=
# For Azure OpenAI, set the base + deployment instead of / alongside the key:
LLM_API_BASE=
LLM_API_VERSION=
LLM_DEPLOYMENT_NAME=

# --- Self-hosted OCR tuning (rapidocr / paddleocr) ---
PADDLEOCR_LANG=en
PADDLEOCR_USE_ANGLE_CLS=true
PADDLEOCR_USE_GPU=false

# --- Extraction defaults ---
# Per-line GST rate to assume when the invoice omits it (fraction: 0.18 = 18%).
OCR_DEFAULT_TAX_RATE=0.18
OCR_DEFAULT_UOM=NOS

# --- Download guards for the presigned document URL ---
OCR_DOWNLOAD_TIMEOUT_SECONDS=30
OCR_MAX_DOCUMENT_MB=25
