# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
.next/
out/
build/
*.tsbuildinfo

# Env & secrets
.env
.env.local
.env.*.local
# Any other .env variant (backups, per-environment copies) — these hold live
# credentials. .env.example is the one intentional exception.
.env.*
!.env.example
*.pem
keys/

# Test & coverage
coverage/
playwright-report/
test-results/
.turbo/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Prisma
packages/db/prisma/*.db

# Word lock files
~$*
docs/**/~$*

# Source workbooks: real operational data (customer names, staff emails).
# Keep local — never in git history.
Docs/
*.xlsx
*.xlsm
